# Config CORS
CORS_ORIGIN=*

# Config PORT
PORT=8080

# Database 
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/backend?schema=public

# JWT — secret 
JWT_ACCESS_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_BASE64_32_ACCESS
JWT_REFRESH_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_BASE64_32_REFRESH
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=24h
ACCESS_TOKEN_REFRESH_THRESHOLD=2m
REFRESH_TOKEN_HASH_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_BASE64_32_REFRESH_HASH

# Forgot password 
PASSWORD_RESET_URL=http://localhost:5173/reset-password
PASSWORD_RESET_EXPIRES_IN=30m

# SMTP สำหรับส่ง email 
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Backend <no-reply@example.com>"
